{
  "name": "geekapi-cli",
  "version": "0.3.0",
  "description": "GeekAPI 中转站快捷工具：一键检测/下载/配置 Claude Code 和 Codex",
  "type": "module",
  "module": "src/index.ts",
  "bin": {
    "geekapi": "dist-npm/index.js"
  },
  "files": [
    "dist-npm",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "homepage": "https://github.com/CoderKuo/geekapi-cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CoderKuo/geekapi-cli.git"
  },
  "bugs": {
    "url": "https://github.com/CoderKuo/geekapi-cli/issues"
  },
  "keywords": [
    "claude-code",
    "codex",
    "cli",
    "geekapi",
    "anthropic",
    "openai",
    "config"
  ],
  "scripts": {
    "dev": "bun run src/index.ts",
    "start": "bun run src/index.ts",
    "build:npm": "bun run scripts/build-npm.ts",
    "build": "bun build src/index.ts --compile --outfile dist/geekapi",
    "build:win": "bun build src/index.ts --compile --target=bun-windows-x64 --outfile dist/geekapi-win.exe",
    "build:mac": "bun build src/index.ts --compile --target=bun-darwin-x64 --outfile dist/geekapi-mac",
    "build:mac-arm": "bun build src/index.ts --compile --target=bun-darwin-arm64 --outfile dist/geekapi-mac-arm",
    "build:linux": "bun build src/index.ts --compile --target=bun-linux-x64 --outfile dist/geekapi-linux",
    "build:all": "bun run build:win && bun run build:mac && bun run build:mac-arm && bun run build:linux",
    "prepublishOnly": "bun run build:npm"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "picocolors": "^1.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.5.0"
  }
}
